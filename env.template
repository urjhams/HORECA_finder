# Germany Restaurant Finder - Environment Configuration
# Rename this file to .env (remove .template extension)

# Google Maps API Key (REQUIRED)
# Get from: https://console.cloud.google.com/
# Enable "Places API" and "Maps JavaScript API"
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key (OPTIONAL - only if you want AI classification)
# Get from: https://aistudio.google.com/app/apikey
# Leave blank to skip AI classification and save on costs
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy OpenAI key support (will use GEMINI_API_KEY if not set)
# OPENAI_API_KEY=sk-your_openai_key_here

